# Local environment overrides for podman container.
#
# Copy this file to 'env.local' to activate it ('run-podman.sh' picks it up
# automatically). The file is read by podman on the host and is not mounted
# into the container. Lines are 'KEY=VALUE', '#' starts a comment.

# rustup 加速
RUSTUP_DIST_SERVER=https://rsproxy.cn
RUSTUP_UPDATE_ROOT=https://rsproxy.cn/rustup

# Other variables can be added the same way, e.g. a proxy or a pip mirror for
# build-time python dependencies (they do not affect the postinst script that
# runs on the device):
#https_proxy=http://127.0.0.1:7890
#http_proxy=http://127.0.0.1:7890
#PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
